name: Build KomikArta
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
      - run: chmod +x ./gradlew
      - run: ./gradlew :src:id:komikarta:assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: komikarta-apk
          path: src/id/komikarta/build/outputs/apk/debug/*.apk
